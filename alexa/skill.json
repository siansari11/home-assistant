{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "Our Home",
          "summary": "Personal kitchen timers for Our Home.",
          "description": "Rings the Echo when the Our Home kitchen timer ends. The tablet uses Alexa reminders. Saying Alexa, tell Our Home to set a timer uses an in-session timer."
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": ["DE", "US"]
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "https://our-home-api.YOUR_SUBDOMAIN.workers.dev/alexa"
        },
        "interfaces": []
      }
    },
    "permissions": [
      { "name": "alexa::alerts:reminders:skill:readwrite" },
      { "name": "alexa::alerts:timers:skill:readwrite" }
    ],
    "manifestVersion": "1.0"
  }
}
